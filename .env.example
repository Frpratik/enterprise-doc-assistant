# Copy this file to .env and change values if needed.
# Every setting has a safe default in ingestion/config.py, so .env is optional.

# Windows only: full path to tesseract.exe if it's not on PATH
# INGEST_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Safety limits
INGEST_MAX_FILE_SIZE_MB=50
INGEST_MAX_PAGES=500

# OCR
INGEST_OCR_LANG=eng
INGEST_OCR_TIMEOUT_SEC=30

# Quality thresholds
INGEST_MIN_CHARS_PER_PAGE=50
INGEST_MIN_OCR_CONFIDENCE=0.70
INGEST_MAX_GARBAGE_RATIO=0.30
INGEST_MIN_PAGE_COVERAGE=0.80

# Database (Phase 2) - matches docker-compose.yml
DATABASE_URL=postgresql://eda:eda_local_pw@localhost:5432/eda

# Embeddings: "local" (default, free, offline) or "openai" (needs OPENAI_API_KEY)
INGEST_EMBED_PROVIDER=local
# OPENAI_API_KEY=sk-...

# Background jobs (Phase 2) - Redis from docker-compose
INGEST_CELERY_BROKER_URL=redis://localhost:6379/0
INGEST_CELERY_RESULT_BACKEND=redis://localhost:6379/1
